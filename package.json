{
  "name": "codex-token-usage-history",
  "version": "1.0.0",
  "description": "Real-time Codex token usage and remaining quota monitor (5-hour and weekly limits) for MacBook, Codex APP, and Codex CLI",
  "type": "module",
  "main": "dist/cli/index.js",
  "bin": {
    "codex-usage": "bin/codex-usage"
  },
  "scripts": {
    "demo": "bun scripts/demo.ts",
    "build": "bun build src/cli/index.ts --target node --outdir dist/cli",
    "start": "node --no-warnings dist/cli/index.js",
    "dashboard": "node --no-warnings dist/cli/index.js dashboard",
    "status": "node --no-warnings dist/cli/index.js status",
    "live": "node --no-warnings dist/cli/index.js live",
    "history": "node --no-warnings dist/cli/index.js history",
    "serve": "node --no-warnings dist/cli/index.js dashboard",
    "mcp": "node --no-warnings dist/cli/index.js mcp",
    "hud": "node --no-warnings dist/cli/index.js hud",
    "build:menubar": "bash scripts/build-menubar.sh",
    "build:hud": "bash scripts/build-hud.sh",
    "install:all": "bash scripts/install.sh",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:node": "node --test tests/node-compatibility.mjs"
  },
  "keywords": [
    "codex",
    "token-usage",
    "quota-monitor",
    "rate-limits",
    "macbook"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": "^22.13.0 || >=23.4.0"
  }
}
